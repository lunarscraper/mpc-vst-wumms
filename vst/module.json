    {"key": "level", "name": "Level", "min": -24, "max": 12},
    {"key": "locut", "name": "Lo Cut", "options": ["OFF", "75 HZ", "150 HZ", "300 HZ"]},
    {"key": "hicut", "name": "Hi Cut", "min": 0, "max": 100},
    {"key": "gate", "name": "Gate", "options": ["OFF", "-50 DB", "-40 DB", "-30 DB", "-20 DB", "-10 DB", "0 DB"]},
