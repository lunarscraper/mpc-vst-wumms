    {"key": "release", "name": "Release", "min": 0, "max": 100},
    {"key": "drive", "name": "Drive", "min": 0, "max": 100},
    {"key": "disto", "name": "Disto", "options": ["BOOST", "TUBE", "FUZZ", "SQUARE"]},
